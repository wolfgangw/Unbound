enable_language(OBJCXX)
include("${UNBOUND_ROOT}/infrastructure/macos/resolve-qt.cmake")
if(NOT TARGET UnboundCoreHeaders)
    add_subdirectory("${UNBOUND_ROOT}/src/core" "${CMAKE_CURRENT_BINARY_DIR}/unbound-core")
endif()
if(NOT TARGET UnboundMacWindowing)
    add_library(UnboundMacWindowing STATIC "${CMAKE_CURRENT_LIST_DIR}/windowbackend.mm" "${CMAKE_CURRENT_LIST_DIR}/windowplacement.mm")
    target_include_directories(UnboundMacWindowing PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
    target_link_libraries(UnboundMacWindowing PUBLIC UnboundCoreHeaders "-framework AppKit")
    set_target_properties(UnboundMacWindowing PROPERTIES POSITION_INDEPENDENT_CODE ON)
endif()
