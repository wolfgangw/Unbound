enable_language(OBJCXX)
include("${UNBOUND_ROOT}/infrastructure/macos/resolve-qt.cmake")
if(NOT TARGET UnboundCoreHeaders)
    add_subdirectory("${UNBOUND_ROOT}/src/core" "${CMAKE_CURRENT_BINARY_DIR}/unbound-core")
endif()
if(NOT TARGET UnboundMacWindowing)
    add_library(UnboundMacWindowing STATIC "${CMAKE_CURRENT_LIST_DIR}/windowbackend.mm" "${CMAKE_CURRENT_LIST_DIR}/windowplacement.mm" "${CMAKE_CURRENT_LIST_DIR}/windowpresentation.mm" "${CMAKE_CURRENT_LIST_DIR}/nativemenutracking.mm" "${CMAKE_CURRENT_LIST_DIR}/layouttransitionpresentation.cpp")
    target_sources(UnboundMacWindowing PRIVATE "${CMAKE_CURRENT_LIST_DIR}/windowcontrolclearance.mm")
    target_sources(UnboundMacWindowing PRIVATE "${CMAKE_CURRENT_LIST_DIR}/quirks/scopesheaderrefresh.cpp")
    target_include_directories(UnboundMacWindowing PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
    target_link_libraries(UnboundMacWindowing PUBLIC UnboundCoreHeaders "-framework AppKit" "-framework QuartzCore" "-weak_framework ScreenCaptureKit")
    set_target_properties(UnboundMacWindowing PROPERTIES POSITION_INDEPENDENT_CODE ON)
endif()
