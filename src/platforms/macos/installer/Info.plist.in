<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleIdentifier</key><string>org.unbound.installer</string>
    <key>CFBundleName</key><string>@APP_NAME@</string>
    <key>CFBundleDisplayName</key><string>@APP_NAME@</string>
    <key>CFBundleExecutable</key><string>UnboundInstaller</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key><string>@BUILD@</string>
    <key>UnboundRuntimeBuild</key><string>@RUNTIME_BUILD@</string>
    <key>UnboundPackageBuild</key><string>@PACKAGE_BUILD@</string>
    <key>CFBundleIconFile</key><string>Unbound</string>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
</dict></plist>
