-- Start once and return; never occupy Fusion's shared script executor.
-- Resolve also evaluates script libraries in contexts without native FFI.
-- Those contexts cannot attach Unbound; the FFI-enabled invocation owns startup.
if not (ffi and ffi.cdef and ffi.load) then return end
local ok, failure = pcall(function()
    local home = assert(os and os.getenv and os.getenv("HOME"), "Cannot locate the user home directory")
    local start = assert(loadfile(home .. "/Library/Application Support/Unbound/Runtime/load.lua"))
    start()
end)
if not ok and print then
    print("Unbound automatic startup failed: " .. tostring(failure))
end
