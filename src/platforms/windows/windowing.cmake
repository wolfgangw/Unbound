# Also used by standalone fixtures and diagnostic builds.
if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "The Windows backend requires Windows x64 and MSVC")
endif()
find_package(Qt5 5.15.2 EXACT REQUIRED COMPONENTS Widgets)
if(NOT TARGET UnboundCoreHeaders)
    add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/../../core" "${CMAKE_CURRENT_BINARY_DIR}/unbound-core")
endif()
if(NOT TARGET UnboundWindowsWindowing)
    add_library(UnboundWindowsWindowing STATIC "${CMAKE_CURRENT_LIST_DIR}/windowplacement.cpp" "${CMAKE_CURRENT_LIST_DIR}/windowpresentation.cpp" "${CMAKE_CURRENT_LIST_DIR}/nativemenutracking.cpp")
    target_sources(UnboundWindowsWindowing PRIVATE "${CMAKE_CURRENT_LIST_DIR}/layouttransitioncover.cpp")
    set_property(TARGET UnboundWindowsWindowing PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
    target_include_directories(UnboundWindowsWindowing PUBLIC "${CMAKE_CURRENT_LIST_DIR}")
    target_link_libraries(UnboundWindowsWindowing PUBLIC UnboundCoreHeaders shell32 ole32 uuid dwmapi comctl32)
endif()
